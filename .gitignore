# Secrets — NEVER commit real values.
# env/development.json / env/staging.json / env/production.json (see
# lib/app/config/env.dart, loaded via --dart-define-from-file) contain
# either dev-convenience or placeholder values only — see each file. A
# real production/staging config should come from CI secret storage
# writing a local override file at build time, never a committed one;
# *.local.json here is that override's naming convention.
env/*.local.json
.env.local
.env.*.local
google-services.json
GoogleService-Info.plist
firebase_options.dart

# Coverage
coverage/
